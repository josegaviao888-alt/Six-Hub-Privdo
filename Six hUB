--// CHARACTER CONFIG & SECURITY LOGIC
local Humanoid
local speedConnection = nil

local function GetRightArm(character)
    if not character then return nil end
    return character:WaitForChild("RightHand", 5) or character:WaitForChild("Right Arm", 5)
end

local function ApplyArmReach(character)
    if not ArmReachConfig.Enabled then return end
    local arm = GetRightArm(character)
    if arm then
        if not ArmReachConfig.OriginalSize then
            ArmReachConfig.OriginalSize = arm.Size
            ArmReachConfig.OriginalTransparency = arm.Transparency
        end
        arm.Size = Vector3.new(20, 20, 20)
        arm.Transparency = 0.8
        arm.Massless = true
        arm.CanCollide = false
    end
end

local function ResetArmReach(character)
    local arm = GetRightArm(character)
    if arm and ArmReachConfig.OriginalSize then
        arm.Size = ArmReachConfig.OriginalSize
        arm.Transparency = ArmReachConfig.OriginalTransparency
        arm.Massless = false
        arm.CanCollide = true
    end
end

local function ApplySpeed(character)
    if not character then return end
    Humanoid = character:WaitForChild("Humanoid", 5)
    if Humanoid then
        if SprintSettings.Enabled then
            Humanoid.WalkSpeed = SprintSettings.SprintSpeed
        else
            Humanoid.WalkSpeed = SprintSettings.NormalSpeed
        end
        
        if speedConnection then speedConnection:Disconnect() end
        
        speedConnection = Humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if SprintSettings.Enabled and Humanoid.WalkSpeed ~= SprintSettings.SprintSpeed then
                Humanoid.WalkSpeed = SprintSettings.SprintSpeed
            elseif not SprintSettings.Enabled and Humanoid.WalkSpeed ~= SprintSettings.NormalSpeed then
                Humanoid.WalkSpeed = SprintSettings.NormalSpeed
            end
        end)
    end
    
    if ArmReachConfig.Enabled then
        task.wait(0.2)
        ApplyArmReach(character)
    end
end

if Player.Character then task.spawn(ApplySpeed, Player.Character) end
Player.CharacterAdded:Connect(function(char)
    task.wait(0.5)
