CreateScriptButton(OutrosTab, "Tela Limpa", function()
    Notify("Executando Tela Limpa...")
    task.spawn(function()
        local LimparPlayers = game:GetService("Players")
        local LimparUIS = game:GetService("UserInputService")

        local LocalPlayer = LimparPlayers.LocalPlayer
        local LimparPlayerGui = LocalPlayer:WaitForChild("PlayerGui")

        local Limpo = false
        local GUIsOcultadas = {}

        local function LimparTela()
            for _, gui in ipairs(LimparPlayerGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Name ~= "CleanScreenGUI" and gui.Name ~= "SixxinhoAurudoHubV1" then
                    GUIsOcultadas[gui] = gui.Enabled
                    gui.Enabled = false
                end
            end
            Limpo = true
        end

        local function RestaurarTela()
            for gui, estado in pairs(GUIsOcultadas) do
                if gui and gui.Parent then
                    gui.Enabled = estado
                end
            end
            Limpo = false
        end

        pcall(function()
            if LimparPlayerGui:FindFirstChild("CleanScreenGUI") then
                LimparPlayerGui["CleanScreenGUI"]:Destroy()
            end
        end)

        local ScreenGui = Instance.new("ScreenGui")
        ScreenGui.Name = "CleanScreenGUI"
        ScreenGui.ResetOnSpawn = false
        ScreenGui.Parent = LimparPlayerGui

        local Botao = Instance.new("TextButton")
        Botao.Size = UDim2.new(0, 160, 0, 45)
        Botao.Position = UDim2.new(0.5, -80, 0.15, 0)
        Botao.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        Botao.TextColor3 = Color3.new(1,1,1)
        Botao.TextScaled = true
        Botao.Text = "🖥️ LIMPAR: OFF"
        Botao.Parent = ScreenGui

        Botao.MouseButton1Click:Connect(function()
            if not Limpo then
                LimparTela()
                Botao.Text = "🖥️ LIMPAR: ON"
            else
                RestaurarTela()
                Botao.Text = "🖥️ LIMPAR: OFF"
            end
        end)

        local dragging = false
        local dragInput
        local dragStart
        local startPos

        local function update(input)
            local delta = input.Position - dragStart
            Botao.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end

        Botao.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

                dragging = true
                dragStart = input.Position
                startPos = Botao.Position

                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        Botao.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)

        LimparUIS.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                update(input)
            end
        end)
        
        Notify("Tela Limpa injetada com sucesso!")
    end)
end)

CreateScriptButton(OutrosTab, "🌈 Angelo Hub (Original)", function()
    Notify("Executando Angelo Hub...")
    task.spawn(function()
        local AngeloPlayers = game:GetService("Players")
        local AngeloRunService = game:GetService("RunService")
        local AngeloUserInputService = game:GetService("UserInputService")
        local AngeloLighting = game:GetService("Lighting")

        local LP = AngeloPlayers.LocalPlayer
        local Root, Humanoid

        local function UpdateChar()
            if LP.Character then
                Root = LP.Character:FindFirstChild("HumanoidRootPart")
                Humanoid = LP.Character:FindFirstChildOfClass("Humanoid")
            end
        end
        UpdateChar()
        LP.CharacterAdded:Connect(UpdateChar)

        local CFG = {
            Open = true,
            Atravessar = false,
            Reach = false,
            AutoDesarme = false,
            AntiPulo = false,
            Speed = false,
            AntiLag = false,
            FPS = false
        }

        local REACH_DIST = 11

        local function GetBall()
            return workspace:FindFirstChild("Ball")
                or workspace:FindFirstChild("Football")
                or workspace:FindFirstChild("SoccerBall")
        end

        local function AtravessarPlayers()
            for _,plr in pairs(AngeloPlayers:GetPlayers()) do
                if plr ~= LP and plr.Character then
                    for _,p in pairs(plr.Character:GetDescendants()) do
                        if p:IsA("BasePart") then
                            p.CanCollide = false
                        end
                    end
                end
            end
        end

        local function Reach()
            local ball = GetBall()
            if not ball or not Root then return end

            for _,plr in pairs(AngeloPlayers:GetPlayers()) do
                if plr ~= LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (plr.Character.HumanoidRootPart.Position - Root.Position).Magnitude
                    if d <= REACH_DIST then
                        ball.CFrame = Root.CFrame * CFrame.new(0,0,-1.8)
                    end
                end
            end
        end

        local function AutoDesarme()
            local ball = GetBall()
            if not ball or not Root then return end

            for _,plr in pairs(AngeloPlayers:GetPlayers()) do
                if plr ~= LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (plr.Character.HumanoidRootPart.Position - Root.Position).Magnitude
                    if d < 9 then
                        ball.CFrame = Root.CFrame * CFrame.new(0,0,-2)
                    end
                end
            end
        end

        local function AntiLagBola()
            local ball = GetBall()
            if ball and ball:IsA("BasePart") then
                pcall(function() ball:SetNetworkOwner(LP) end)
                ball.AssemblyLinearVelocity *= 0.85
                ball.AssemblyAngularVelocity *= 0.85
            end
        end

        pcall(function()
            game.CoreGui:FindFirstChild("ANGEL_HUB"):Destroy()
        end)

        local gui = Instance.new("ScreenGui")
        gui.Name = "ANGEL_HUB"
        gui.ResetOnSpawn = false
        gui.Parent = game.CoreGui

        local main = Instance.new("Frame", gui)
        main.Size = UDim2.new(0,260,0,380)
        main.Position = UDim2.new(0.05,0,0.2,0)
        main.BackgroundColor3 = Color3.fromRGB(20,20,25)
        main.Active = true
        main.Draggable = true
        main.Visible = CFG.Open

        local title = Instance.new("TextLabel", main)
        title.Size = UDim2.new(1,0,0,40)
        title.BackgroundColor3 = Color3.fromRGB(140,0,255)
        title.Text = "🌈 ANGELO HUB"
        title.TextColor3 = Color3.new(1,1,1)
        title.Font = Enum.Font.GothamBold
        title.TextScaled = true

        local function MakeBtn(nome, ordem, callback)
            local b = Instance.new("TextButton", main)
            b.Size = UDim2.new(1,-20,0,38)
            b.Position = UDim2.new(0,10,0,50 + ordem*42)
            b.BackgroundColor3 = Color3.fromRGB(90,0,0)
            b.TextColor3 = Color3.new(1,1,1)
            b.Font = Enum.Font.GothamBold
            b.TextScaled = true
