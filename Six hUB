                callback(CFG[nome])
            end)
        end

        MakeBtn("Atravessar",0,function() end)
        MakeBtn("Reach",1,function() end)
        MakeBtn("AutoDesarme",2,function() end)
        MakeBtn("AntiPulo",3,function(v)
            if Humanoid then Humanoid.JumpPower = v and 0 or 50 end
        end)
        MakeBtn("Speed",4,function(v)
            if Humanoid then Humanoid.WalkSpeed = v and 45 or 16 end
        end)
        MakeBtn("AntiLag",5,function() end)
        MakeBtn("FPS",6,function(v)
            if v then
                settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
                AngeloLighting.GlobalShadows = false
            else
                AngeloLighting.GlobalShadows = true
                settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
            end
        end)

        local toggle = Instance.new("TextButton", gui)
        toggle.Size = UDim2.new(0,140,0,35)
        toggle.Position = UDim2.new(0.05,0,0.1,0)
        toggle.Text = "ANGEL HUB"
        toggle.BackgroundColor3 = Color3.fromRGB(140,0,255)
        toggle.TextColor3 = Color3.new(1,1,1)
        toggle.Font = Enum.Font.GothamBold

        toggle.MouseButton1Click:Connect(function()
            CFG.Open = not CFG.Open
            main.Visible = CFG.Open
        end)

        AngeloUserInputService.InputBegan:Connect(function(i,g)
            if not g and i.KeyCode == Enum.KeyCode.P then
                CFG.Open = not CFG.Open
                main.Visible = CFG.Open
            end
        end)

        AngeloRunService.Heartbeat:Connect(function()
            if CFG.Atravessar then AtravessarPlayers() end
            if CFG.Reach then Reach() end
            if CFG.AutoDesarme then AutoDesarme() end
            if CFG.AntiLag then AntiLagBola() end
