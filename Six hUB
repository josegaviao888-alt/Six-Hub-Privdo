local PhysicsConnection
PhysicsConnection = RunService.Heartbeat:Connect(function()
    if ChicleteConfig.Enabled then ProcessChicleteMagnet() end

    local allPlayers = Players:GetPlayers()
    for i = 1, #allPlayers do
        local p = allPlayers[i]
        if p ~= Player and p.Character then
            local char = p.Character
            
            if AbsurdoConfig.Enabled then
                pcall(function()
                    for _, part in ipairs(char:GetChildren()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end)
            end
            
            if ReachSettings.ReachEnabled then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    local hitBox = root:FindFirstChild("SuperChuteHitbox")
                    if not hitBox then
                        pcall(function()
                            hitBox = Instance.new("Part")
                            hitBox.Name = "SuperChuteHitbox"
                            hitBox.Size = ReachSettings.ReachSize
                            hitBox.Transparency = 1
                            hitBox.CanCollide = false
                            hitBox.Massless = true
                            hitBox.Parent = root
                            
                            local weld = Instance.new("ManualWeld")
                            weld.Name = "HitboxWeld"
                            weld.Part0 = root
                            weld.Part1 = hitBox
                            weld.C0 = CFrame.new(0, 0, 0)
                            weld.Parent = hitBox
                        end)
                    end
                end
            end
            
            if DesarmeConfig.Enabled then
                local back = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                if back and not back:FindFirstChild("DesarmeBack") then
                    pcall(function()
                        local backBox = Instance.new("Part")
                        backBox.Name = "DesarmeBack"
                        backBox.Size = DesarmeConfig.Sizes.Back
                        backBox.Transparency = 1
                        backBox.CanCollide = false
                        backBox.Massless = true
                        backBox.Parent = back
                        
                        local weld = Instance.new("ManualWeld")
                        weld.Part0 = back
                        weld.Part1 = backBox
                        weld.C0 = CFrame.new(0, 0, 20)
                        weld.Parent = backBox
                    end)
                end
                
                local legs = {"LeftLeg", "RightLeg", "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg"}
                for _, legName in ipairs(legs) do
                    local leg = char:FindFirstChild(legName)
                    if leg and not leg:FindFirstChild("DesarmeLeg") then
                        pcall(function()
                            local legBox = Instance.new("Part")
                            legBox.Name = "DesarmeLeg"
                            legBox.Size = DesarmeConfig.Sizes.Leg
                            legBox.Transparency = 1
                            legBox.CanCollide = false
                            legBox.Massless = true
                            legBox.Parent = leg
                            
                            local weld = Instance.new("ManualWeld")
                            weld.Part0 = leg
                            weld.Part1 = legBox
                            weld.C0 = CFrame.new(0, -15, 0)
                            weld.Parent = legBox
                        end)
                    end
                end
            end
            
        end
    end
end)

