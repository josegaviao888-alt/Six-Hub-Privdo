--// FILTRO SOCCER CONFIG
local isZyckActive = false
local function optimizeInstanceZyck(obj)
    if not isZyckActive then return end
    pcall(function()
        if obj.Name == "Soccer" and (obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture")) then
            obj.Transparency = 1
        end
        if obj:IsA("Part") or obj:IsA("UnionOperation") or obj:IsA("MeshPart") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
            obj.CastShadow = false
        elseif (obj:IsA("Decal") or obj:IsA("Texture")) and obj.Name ~= "Soccer" then
            obj:Destroy()
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
            obj.Enabled = false
        end
    end)
end

game.DescendantAdded:Connect(function(newObj)
    if isZyckActive then optimizeInstanceZyck(newObj) end
end)

