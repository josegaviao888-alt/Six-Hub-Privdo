--// MOTOR CHICLETÃO (ENCONTRAR BOLA)
local function FindBrookhavenBall()
    local workspaceDescendants = workspace:GetChildren()
    for i = 1, #workspaceDescendants do
        local obj = workspaceDescendants[i]
        if obj:IsA("BasePart") or obj:IsA("MeshPart") then
            local name = obj.Name:lower()
            if (name:find("ball") or name:find("bola") or name:find("soccer") or name:find("football") or name:find("chiclete")) and not obj:IsDescendantOf(Player.Character) then
                if obj.Shape == Enum.PartType.Ball or (obj:FindFirstChildOfClass("SpecialMesh") and obj:FindFirstChildOfClass("SpecialMesh").MeshType == Enum.MeshType.Sphere) then
                    return obj
                end
            end
        end
    end
    return nil
end

local function ReleaseChicleteBall()
    if ChicleteConfig.BodyPos then pcall(function() ChicleteConfig.BodyPos:Destroy() end) ChicleteConfig.BodyPos = nil end
    if ChicleteConfig.BodyG then pcall(function() ChicleteConfig.BodyG:Destroy() end) ChicleteConfig.BodyG = nil end
    ChicleteConfig.CurrentBall = nil
end

local function ProcessChicleteMagnet()
    if not ChicleteConfig.Enabled then return end
    local character = Player.Character
    if not character then return end
    
    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not head or not root then return end
    
    if not ChicleteConfig.CurrentBall or not ChicleteConfig.CurrentBall.Parent then
        ChicleteConfig.CurrentBall = FindBrookhavenBall()
        if not ChicleteConfig.CurrentBall then return end
    end
    
    pcall(function()
        if not ChicleteConfig.BodyPos then
            ChicleteConfig.BodyPos = Instance.new("BodyPosition")
            ChicleteConfig.BodyPos.MaxForce = Vector3.new(50000, 50000, 50000)
            ChicleteConfig.BodyPos.P = 15000
            ChicleteConfig.BodyPos.D = 500
            ChicleteConfig.BodyPos.Parent = ChicleteConfig.CurrentBall
        end
        
        if not ChicleteConfig.BodyG then
            ChicleteConfig.BodyG = Instance.new("BodyGyro")
            ChicleteConfig.BodyG.MaxTorque = Vector3.new(50000, 50000, 50000)
            ChicleteConfig.BodyG.P = 10000
            ChicleteConfig.BodyG.Parent = ChicleteConfig.CurrentBall
        end
        
        local targetPos = head.Position + (root.CFrame.LookVector * 4) + Vector3.new(0, 6, 0)
        ChicleteConfig.BodyPos.Position = targetPos
        ChicleteConfig.BodyG.CFrame = root.CFrame
    end)
end

--// MOTOR DE GERENCIAMENTO DE HITBOXES
local function RemoveReachHitbox(p)
    pcall(function()
        if p and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local hitBox = root:FindFirstChild("SuperChuteHitbox")
                if hitBox then hitBox:Destroy() end
            end
        end
    end)
end

local function RemoveDesarmeHitbox(p)
    pcall(function()
        if p and p.Character then
            local character = p.Character
            local back = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
            if back then
                local box = back:FindFirstChild("DesarmeBack")
                if box then box:Destroy() end
            end
            
            local legs = {"LeftLeg", "RightLeg", "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg"}
            for _, legName in ipairs(legs) do
                local leg = character:FindFirstChild(legName)
                if leg then
                    local box = leg:FindFirstChild("DesarmeLeg")
                    if box then box:Destroy() end
                end
            end
        end
    end)
end

